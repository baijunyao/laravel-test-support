{
    "name": "baijunyao/laravel-test-support",
    "keywords": [
        "laravel",
        "test",
        "support"
    ],
    "description": "Laravel Test Support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "baijunyao",
            "email": "baijunyao@baijunyao.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/testing": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "nesbot/carbon": "^3.3",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "vlucas/phpdotenv": "^5.3"
    },
    "require-dev": {
        "baijunyao/php-cs-fixer-config": "^0.3",
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Baijunyao\\LaravelTestSupport\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "phpcs": "vendor/bin/php-cs-fixer fix",
        "lint": [
            "composer phpcs"
        ],
        "test": "vendor/bin/pest"
    },
    "autoload-dev": {
        "psr-4": {
            "Baijunyao\\LaravelTestSupport\\Tests\\": "tests/"
        }
    }
}
